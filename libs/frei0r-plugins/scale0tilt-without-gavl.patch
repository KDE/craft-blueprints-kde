+		(src_w < EPSILON) || (src_h < EPSILON)) {
 
-	if((dst_w < EPSILON) || (dst_h < EPSILON) ||
-	   (src_w < EPSILON) || (src_h < EPSILON)) {
 		inst->do_scale = 0;
+	return;
+		}
+
+		/*
+		 * Clip right edge.
+		 *
+		 * Keep the source and destination scaling ratio unchanged.
+		 */
+		if (dst_x + dst_w > (double)inst->w) {
+			src_w *=
+			((double)inst->w - dst_x) / dst_w;
+
+			dst_w =
+			(double)inst->w - dst_x;
+		}
+
+		/*
+		 * Clip bottom edge.
+		 */
+		if (dst_y + dst_h > (double)inst->h) {
+			src_h *=
+			((double)inst->h - dst_y) / dst_h;
+
+			dst_h =
+			(double)inst->h - dst_y;
+		}
+
+		/*
+		 * Clip left edge.
