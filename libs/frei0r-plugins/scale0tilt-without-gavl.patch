+/*
+ * Calculate the source and destination rectangles.
+ *
+ * This preserves the clipping behavior of the original gavl version.
+ */
+static void update_scaler(scale0tilt_instance_t *inst)
+{
+	double src_x, src_y, src_w, src_h;
+	double dst_x, dst_y, dst_w, dst_h;
+
+	inst->do_scale = 1;
+
+	src_x = (double)inst->w * inst->cl;
+	src_y = (double)inst->h * inst->ct;
+
+	src_w = (double)inst->w *
+	(1.0 - inst->cl - inst->cr);
+
+	src_h = (double)inst->h *
+	(1.0 - inst->ct - inst->cb);
+
+	dst_x = (double)inst->w * inst->cl * inst->sx +
+	inst->tx * (double)inst->w;
+
+	dst_y = (double)inst->h * inst->ct * inst->sy +
+	inst->ty * (double)inst->h;
+
+	dst_w = (double)inst->w *
+	(1.0 - inst->cl - inst->cr) *
+	inst->sx;
+
+	dst_h = (double)inst->h *
+	(1.0 - inst->ct - inst->cb) *
+	inst->sy;
+
+	/*
+	 * Nothing to render.
+	 */
