+		if (dst_x < 0.0) {
+			src_x -=
+			dst_x * (src_w / dst_w);
+
+			src_w *=
+			(dst_w + dst_x) / dst_w;
+
+			dst_w += dst_x;
+			dst_x = 0.0;
+		}
+
+		/*
+		 * Clip top edge.
+		 */
